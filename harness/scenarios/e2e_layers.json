{
  "description": "Composition layers through VDXR + OVRShim: head-locked quad, world-locked rotated quad, cylinder, cube (behind a transparent projection layer), left-eye-only quad, and a 50%-alpha quad over an opaque sub-rect quad. A pinhole-projection oracle (independent of the shim's matrices) predicts where each layer's test points must land in the decoded stream",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 560
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 560,
    "timeout_s": 90,
    "layer_test": 2
  },
  "gpu_sample": true,
  "timeout_s": 240,
  "checks": {
    "timestamps_monotonic": true,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 80,
    "pose_roundtrip_max_rad": 0.06,
    "refresh_hz": 90,
    "max_pipeline_latency_ms": 150,
    "layers": {
      "min_frames": 20,
      "min_ok_frac": 0.9
    },
    "app_min_frames": 500,
    "host_min_frames": 400,
    "client_min_frames": 400
  }
}