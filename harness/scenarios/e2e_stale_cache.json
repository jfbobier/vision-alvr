{
 "description": "STALE CACHE: the session's derived openvr_config cache (eye size 1776x1600, 72 Hz, foveation off) differs from what ALVR negotiates (3552x3200, 90 Hz, foveation on). ALVR drops the first connection (it asks SteamVR to restart, which does not exist here); the host must rebuild its encoder from the negotiated stream on the retry, before the app starts, and the app must see the negotiated resolution/FoV",
 "topology": {
  "host": "builder",
  "client": "builder",
  "client_bind_ip": "127.0.0.2",
  "host_launch": "interactive"
 },
 "session_overrides": {
  "openvr_config.eye_resolution_width": 1776,
  "openvr_config.eye_resolution_height": 1600,
  "openvr_config.target_eye_resolution_width": 1776,
  "openvr_config.target_eye_resolution_height": 1600,
  "openvr_config.refresh_rate": 72,
  "openvr_config.enable_foveated_encoding": false
 },
 "host": {
  "shim": true,
  "fps": 90,
  "seconds": 60,
  "connect_timeout": 45,
  "gpu_keepalive": 90,
  "exit_after_frames": 420
 },
 "client": {
  "seconds": 55,
  "connect_timeout": 45,
  "yaw_amp": 0.5,
  "yaw_hz": 0.25
 },
 "client_env": {
  "RUST_LOG": "warn"
 },
 "app": {
  "frames": 420,
  "timeout_s": 60
 },
 "gpu_sample": true,
 "timeout_s": 200,
 "checks": {
  "host_min_frames": 250,
  "client_min_frames": 200,
  "timestamps_monotonic": false,
  "max_duplicate_timestamps": 400,
  "min_delivery_ratio": 0.7,
  "codec": "Hevc",
  "stream": {
   "codec_name": "hevc",
   "profile": "Main 10",
   "pix_fmt": "yuv420p10le",
   "color_range": "pc",
   "width": 4224,
   "height": 1664
  },
  "decode": true,
  "decode_frame_slack": 60,
  "counter_readback": true,
  "counter_block_px": 64,
  "gray_patch": [
   176,
   200
  ],
  "app_min_frames": 300,
  "pose_roundtrip_max_rad": 0.06,
  "min_yaw_range_rad": 0.3,
  "refresh_hz": 90,
  "max_pipeline_latency_ms": 150,
  "negotiated": {
   "view_resolution": [
    3552,
    3200
   ],
   "use_full_range": true,
   "enable_foveated_encoding": true
  },
  "foveation": true,
  "max_encode_ms_p95": 16,
  "host_min_reconfigurations": 1
 },
 "keep_cache_stale": true
}