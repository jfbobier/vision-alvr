{
  "description": "Daemon host: a headset session, then a disconnect and a second session against the SAME host process (no restart); the host has no time limits (--daemon) and is stopped by the harness",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "daemon": true,
    "gpu_keepalive": 90
  },
  "client": {
    "seconds": 8,
    "connect_timeout": 45
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "timeout_s": 150,
  "checks": {
    "client_min_frames": 100,
    "timestamps_monotonic": true,
    "max_duplicate_timestamps": 400,
    "codec": "Hevc"
  },
  "reconnect": {
    "gap_s": 3,
    "min_frames": 100
  }
}