{
 "description": "QP map + milder foveation (edge ratios 2.5/3, about +30% pixels) through the whole OpenXR chain at the user's resolution: NVENC accepts the map on the warped layout, the map equals the Python port (FFR-aware), the stream is the milder layout's size and the oracles still hold. No pacing thresholds here: on the 1-engine laptop this layout encodes in ~13 ms (> 11.1 ms), i.e. it is encode-bound at ~77 fps; judge it on the 5090 (3 engines, split encode)",
 "topology": {
  "host": "builder",
  "client": "builder",
  "client_bind_ip": "127.0.0.2",
  "host_launch": "interactive"
 },
 "session_overrides": {
  "session_settings.video.foveated_encoding.content.edge_ratio_x": 2.5,
  "session_settings.video.foveated_encoding.content.edge_ratio_y": 3.0,
  "openvr_config.foveation_edge_ratio_x": 2.5,
  "openvr_config.foveation_edge_ratio_y": 3.0
 },
 "host": {
  "shim": true,
  "fps": 90,
  "seconds": 60,
  "connect_timeout": 45,
  "gpu_keepalive": 90,
  "exit_after_frames": 420,
  "qp_map": "on",
  "dump_qpmap": true
 },
 "client": {
  "seconds": 55,
  "connect_timeout": 45,
  "yaw_amp": 0.5,
  "yaw_hz": 0.25
 },
 "client_env": {
  "RUST_LOG": "warn"
 },
 "app": {
  "frames": 420,
  "timeout_s": 60
 },
 "gpu_sample": true,
 "timeout_s": 200,
 "checks": {
  "host_min_frames": 250,
  "client_min_frames": 200,
  "timestamps_monotonic": true,
  "max_duplicate_timestamps": 400,
  "min_delivery_ratio": 0.7,
  "codec": "Hevc",
  "stream": {
   "codec_name": "hevc",
   "profile": "Main 10",
   "pix_fmt": "yuv420p10le",
   "color_range": "pc",
   "width": 4800,
   "height": 1952
  },
  "decode": true,
  "decode_frame_slack": 60,
  "counter_readback": true,
  "counter_block_px": 64,
  "gray_patch": [
   176,
   200
  ],
  "app_min_frames": 300,
  "pose_roundtrip_max_rad": 0.06,
  "min_yaw_range_rad": 0.3,
  "refresh_hz": 90,
  "max_pipeline_latency_ms": 150,
  "negotiated": {
   "view_resolution": [
    3552,
    3200
   ],
   "use_full_range": true,
   "enable_foveated_encoding": true
  },
  "foveation": true,
  "max_encode_ms_p95": 16,
  "qpmap": {
   "on": true,
   "center": -3,
   "edge": 6,
   "transition": 1.0
  }
 }
}