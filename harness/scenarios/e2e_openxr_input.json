{
  "description": "OpenXR app with Touch-profile input: the client's scripted controllers (poses, trigger/squeeze ramps, buttons, thumbstick) must reach the app through ALVR's own button mapping, and the app's haptics must reach the client",
  "topology": {
    "host": "builder",
    "client": "builder",
    "client_bind_ip": "127.0.0.2",
    "host_launch": "interactive"
  },
  "session_overrides": {
    "session_settings.video.foveated_encoding.enabled": false,
    "openvr_config.enable_foveated_encoding": false,
    "openvr_config.eye_resolution_width": 1760,
    "openvr_config.eye_resolution_height": 1600,
    "openvr_config.target_eye_resolution_width": 1760,
    "openvr_config.target_eye_resolution_height": 1600,
    "session_settings.connection.client_recv_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.connection.server_send_buffer_bytes": {
      "variant": "Custom",
      "Custom": 16777216
    },
    "session_settings.headset.controllers.content.left_controller_position_offset.content": [
      0.0,
      0.0,
      0.0
    ],
    "session_settings.headset.controllers.content.left_controller_rotation_offset.content": [
      0.0,
      0.0,
      0.0
    ],
    "session_settings.video.transcoding_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    },
    "session_settings.video.emulated_headset_view_resolution": {
      "Scale": 1.0,
      "Absolute": {
        "width": 1760,
        "height": {
          "set": true,
          "content": 1600
        }
      },
      "variant": "Absolute"
    }
  },
  "host": {
    "shim": true,
    "fps": 90,
    "seconds": 60,
    "connect_timeout": 45,
    "gpu_keepalive": 90,
    "exit_after_frames": 420
  },
  "client": {
    "seconds": 55,
    "connect_timeout": 45,
    "yaw_amp": 0.5,
    "yaw_hz": 0.25,
    "controllers": true
  },
  "client_env": {
    "RUST_LOG": "warn"
  },
  "app": {
    "frames": 420,
    "timeout_s": 60,
    "input": true
  },
  "gpu_sample": true,
  "timeout_s": 200,
  "checks": {
    "host_min_frames": 250,
    "client_min_frames": 200,
    "timestamps_monotonic": true,
    "max_duplicate_timestamps": 400,
    "min_delivery_ratio": 0.7,
    "codec": "Hevc",
    "stream": {
      "codec_name": "hevc",
      "profile": "Main 10",
      "pix_fmt": "yuv420p10le",
      "width": 3520,
      "height": 1600,
      "color_range": "pc"
    },
    "decode": true,
    "decode_frame_slack": 40,
    "counter_readback": true,
    "counter_block_px": 64,
    "gray_patch": [
      176,
      200
    ],
    "app_min_frames": 300,
    "pose_roundtrip_max_rad": 0.06,
    "min_yaw_range_rad": 0.3,
    "controllers": {
      "min_frac_ok": 0.95,
      "max_pose_resid_m": 0.01,
      "min_haptic_events": 4,
      "min_haptic_amplitude": 0.4
    },
    "refresh_hz": 90,
    "max_pipeline_latency_ms": 150
  }
}